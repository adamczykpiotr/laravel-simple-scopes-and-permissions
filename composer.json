{
    "name": "adamczykpiotr/laravel-simple-scopes-and-permissions",
    "description": "Simple, explicit permission checks and row-level query scopes constraining what data a user can access",
    "keywords": [
        "AdamczykPiotr",
        "laravel",
        "simple-scopes-and-permissions"
    ],
    "homepage": "https://github.com/adamczykpiotr/laravel-simple-scopes-and-permissions",
    "license": "MIT",
    "authors": [
        {
            "name": "Piotr Adamczyk",
            "email": "admin@adamczykpiotr.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^7.10||^8.8",
        "larastan/larastan": "^2.9||^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0||^8.0.0",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^13.4.5",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.4||^2.0"
    },
    "autoload": {
        "psr-4": {
            "AdamczykPiotr\\SimpleScopesAndPermissions\\": "src/",
            "AdamczykPiotr\\SimpleScopesAndPermissions\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdamczykPiotr\\SimpleScopesAndPermissions\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html build/coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdamczykPiotr\\SimpleScopesAndPermissions\\SimpleScopesAndPermissionsServiceProvider"
            ],
            "aliases": {
                "SimpleScopesAndPermissions": "AdamczykPiotr\\SimpleScopesAndPermissions\\Facades\\SimpleScopesAndPermissions"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
